{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.js",
			"**/*.jsx",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"**/*.jsonc",
			"**/.vscode/**/*",
			"!**/node_modules",
			"!**/dist",
			"!**/dist-ssr",
			"!**/.tanstack",
			"!**/.nitro",
			"!**/.output",
			"!**/.vinxi",
			"!**/coverage",
			"!**/convex/_generated/**",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"**",
			"!**/.agents/**",
			"!**/.turbo/**",
			"!**/skills-lock.json"
		],
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
